# AI providers (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter — satu kunci untuk banyak model.
# Kosongkan OPENROUTER_MODEL untuk memakai default model akun OpenRouter.
# Kalau diisi, WAJIB pakai prefix organisasi: openai/gpt-4o, anthropic/claude-sonnet-4.6, dst.
# Kalau OPENAI_API_KEY / GEMINI_API_KEY kosong, request otomatis dilempar ke OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_SITE_URL=https://hq.rizpram.cloud

# Supabase. Leave blank to run in browser demo/localStorage mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
